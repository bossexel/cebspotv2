# Copy to repository root as .env.perf.local (git ignored).
# Application .env.local and .env.test.local are intentionally never loaded.
PERF_SUPABASE_URL=http://127.0.0.1:54321
PERF_ANON_KEY=
PERF_SERVICE_ROLE_KEY=
PERF_ENVIRONMENT=local
PERF_ISOLATED_ACK=yes
# For staging ONLY: verify empty dedicated project, outbound notifications disabled,
# no real payment provider calls, then set BOTH to its exact origin and staging.
# PERF_ENVIRONMENT=staging
# PERF_ALLOWED_ORIGIN=https://YOUR-ISOLATED-PROJECT.supabase.co
PERF_HOSTING_TIER=local Docker; record actual resource limits
PERF_VU_LEVELS=1,5,10,25,50
PERF_SMOKE_SEC=30
PERF_RAMP_SEC=60
PERF_HOLD_SEC=180
PERF_RECOVERY_SEC=60
PERF_TIMEOUT_MS=15000
PERF_PACE_MS=700
PERF_STOP_FAILURE_RATE=0.05
PERF_MAX_GENERATOR_RSS_MB=1024
PERF_MAX_WRITES=10000
PERF_SPOTS=1000
PERF_ACCOUNTS=50
PERF_HISTORY=5000
PERF_RACE_USERS=10
PERF_RACE_ROUNDS=3
PERF_MEDIA_EVERY=10
PERF_PHOTO_PATH=tests/performance/.private/media/synthetic.jpg
PERF_VIDEO_PATH=tests/performance/.private/media/synthetic.mp4
PERF_SYNTHETIC_MEDIA_ACK=yes
# Optional single-job face integration on an isolated service.
PERF_FACE_URL=http://127.0.0.1:8000
PERF_FACE_ISOLATED_ACK=yes
# PERF_FACE_ALLOWED_ORIGIN=https://YOUR-ISOLATED-FACE-SERVICE.example.test
