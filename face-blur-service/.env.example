MEDIAPIPE_FACE_SHORT_MODEL_PATH=./models/blaze_face_short_range.tflite
MEDIAPIPE_FACE_FULL_MODEL_PATH=./models/blaze_face_full_range.tflite
FACE_DETECTION_MIN_CONFIDENCE=0.7
FACE_DETECTION_MIN_SUPPRESSION=0.5
FACE_DETECTION_TILE_SIZE=768
FACE_DETECTION_TILE_OVERLAP=0.25
FACE_DETECTION_MAX_TILES=12
FACE_DETECTION_DUPLICATE_IOU=0.35
FACE_PADDING_RATIO=0.25
FACE_BLUR_KERNEL_RATIO=0.65
FACE_BLUR_JPEG_QUALITY=68
FACE_BLUR_TEMP_DIR=./temp
FACE_BLUR_MAX_IMAGE_BYTES=10485760
FACE_BLUR_MAX_IMAGE_DIMENSION=1280
FACE_BLUR_MAX_SOURCE_PIXELS=80000000
FACE_BLUR_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://127.0.0.1:8081
LOG_LEVEL=INFO
# Server-only Auth verification. Use the same isolated staging project as Android.
SUPABASE_URL=https://your-staging-project.supabase.co
# Prefer the publishable key; SUPABASE_ANON_KEY remains a compatible fallback.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=your-staging-publishable-or-anon-key
# Run exactly one uvicorn worker and one hosting replica. Queue=16, concurrency=1,
# retained jobs=32, per-user pending=2, uploads=10/minute, processing timeout=60s.
# Server-only; match the isolated staging Edge secret. Never EXPO_PUBLIC.
ACCOUNT_DELETION_WORKER_TOKEN=
