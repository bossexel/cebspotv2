{
  "name": "cebspot",
  "version": "1.0.0",
  "description": "CebSpot - Expo React Native spot discovery app",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "set EXPO_NO_DEPENDENCY_VALIDATION=1&& expo start --go --lan --clear --port 8081",
    "start:usb": "adb reverse tcp:8081 tcp:8081 && set EXPO_NO_DEPENDENCY_VALIDATION=1&& expo start --go --localhost --clear --port 8081",
    "android": "set EXPO_NO_DEPENDENCY_VALIDATION=1&& expo start --android --go --lan --clear --port 8081",
    "ios": "set EXPO_NO_DEPENDENCY_VALIDATION=1&& expo start --ios --go --lan --clear --port 8081",
    "web": "set EXPO_NO_DEPENDENCY_VALIDATION=1&& expo start --web --port 8081",
    "web:clean": "set EXPO_NO_DEPENDENCY_VALIDATION=1&& expo start --web --clear --port 8081",
    "dev": "set EXPO_NO_DEPENDENCY_VALIDATION=1&& expo start --web --port 8081",
    "build": "expo export --platform web",
    "map:build": "node scripts/build-map.cjs",
    "map:check": "node scripts/build-map.cjs --check",
    "test:map": "npm run map:check && playwright test --config playwright.map.config.cjs",
    "test:carousel": "node node_modules/expo/bin/cli export --platform web --max-workers 1 --output-dir .codex-tmp/map-review/carousel-export && node tests/explore/carousel.cjs",
    "test:payments": "node --test tests/backend/payments.test.cjs",
    "test:webhook-deployment": "node --use-system-ca scripts/check-paymongo-webhook.mjs",
    "test:paymongo-live-readiness": "node --use-system-ca scripts/check-paymongo-live-readiness.mjs && npm run test:webhook-deployment",
    "test:authenticated-write": "node --use-system-ca scripts/check-authenticated-write.mjs",
    "test:club-floor-plan": "node --use-system-ca scripts/check-club-floor-plan.mjs",
    "test:reservation-checkout": "node --test tests/backend/reservation-checkout-details.test.cjs",
    "map:health": "node --use-system-ca scripts/check-map-health.mjs",
    "preflight:local": "node --use-system-ca scripts/check-backend-readiness.mjs --profile local",
    "preflight:preview": "node --use-system-ca scripts/check-backend-readiness.mjs --profile preview",
    "preflight:production": "node --use-system-ca scripts/check-backend-readiness.mjs --profile production",
    "prestart:tunnel": "node scripts/fix-expo-ngrok-timeout.cjs",
    "start:tunnel": "node --use-system-ca node_modules/expo/bin/cli start --go --tunnel --port 8081",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo/metro-runtime": "4.0.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@supabase/supabase-js": "^2.48.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "expo": "^52.0.0",
    "expo-asset": "~11.0.5",
    "expo-build-properties": "~0.13.3",
    "expo-constants": "~17.0.8",
    "expo-dev-client": "~5.0.20",
    "expo-document-picker": "~13.0.3",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.4",
    "expo-image-manipulator": "~13.0.6",
    "expo-image-picker": "~16.0.6",
    "expo-linking": "~7.0.5",
    "expo-location": "~18.0.10",
    "expo-router": "~4.0.21",
    "expo-screen-orientation": "~8.0.4",
    "expo-splash-screen": "~0.29.24",
    "expo-status-bar": "~2.0.1",
    "expo-updates": "~0.27.5",
    "expo-web-browser": "~14.0.2",
    "leaflet": "1.9.4",
    "lucide-react-native": "^0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-maps": "1.18.0",
    "react-native-notify-kit": "^10.5.0",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.19.13",
    "react-native-webview": "13.12.5",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@playwright/test": "1.63.0",
    "@types/react": "~18.3.12",
    "typescript": "~5.8.2"
  }
}
