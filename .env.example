# CebSpot Expo + Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Backward-compatible fallback supported by the app:
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
EXPO_PUBLIC_CARTO_BASEMAPS_API_KEY=your-carto-basemaps-api-key
EXPO_PUBLIC_PAYMONGO_GCASH_ENABLED=false
EXPO_PUBLIC_PAYMONGO_QRPH_ENABLED=true
# Published EAS builds require a public HTTPS endpoint.
EXPO_PUBLIC_FACE_BLUR_API_URL=https://your-face-blur-service.example.com
# Local physical-device development can instead use http://YOUR_COMPUTER_LAN_IP:8000.

# Supabase Edge Function secrets, set with:
# supabase secrets set PAYMONGO_SECRET_KEY=sk_test_xxx PAYMONGO_PUBLIC_KEY=pk_test_xxx PAYMONGO_WEBHOOK_SECRET=whsk_xxx OWNER_INVITE_REDIRECT_URL=cebspot://reset-password
PAYMONGO_SECRET_KEY=sk_test_xxx
PAYMONGO_PUBLIC_KEY=pk_test_xxx
PAYMONGO_WEBHOOK_SECRET=whsk_xxx
# Required test-mode webhook secret. Live callbacks are disabled for this release.
PAYMONGO_TEST_WEBHOOK_SECRET=
# Server-only scheduler credential: generate privately; never put it in EXPO_PUBLIC variables.
PAYMENT_WORKER_TOKEN=
# Server-only hourly orphan cleanup credential (at least 32 characters).
PRIVATE_UPLOAD_WORKER_TOKEN=
# Static return bridge on the retained Render admin origin; does not authorize payment.
CHECKOUT_RETURN_BASE_URL=https://your-admin-service.onrender.com/payment-return.html
OWNER_INVITE_REDIRECT_URL=cebspot://reset-password
