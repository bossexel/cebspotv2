{
  "cli": {
    "version": ">= 18.8.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "autoIncrement": true,
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview"
    },
    "beta": {
      "autoIncrement": true,
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview",
      "env": {
        "CEBSPOT_RUNTIME_ENV": "public-beta",
        "CEBSPOT_BETA_ALLOWED_SUPABASE_REF": "fathkdyxgeeokxeobxqp",
        "CEBSPOT_BETA_ALLOWED_FACE_HOST": "cebspot-face-anonymizer.onrender.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
